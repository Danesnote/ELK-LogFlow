# 운영 구성 공통 환경변수. 복사해서 deploy/prod/.env 로 만들고 값을 채운다 (.env 는 커밋하지 않음)
#   cp deploy/prod/.env.example deploy/prod/.env

# ---------- 공통 ----------
# 포트를 열 내부망 IP. 0.0.0.0 으로 두면 외부에 그대로 노출되므로 반드시 내부 인터페이스로 지정
BIND_IP=10.0.0.10

# ---------- Kafka (deploy/prod/kafka) ----------
# KRaft 클러스터 ID. 한 번 정하면 바꾸지 않음
#   docker run --rm confluentinc/cp-kafka:7.6.1 kafka-storage random-uuid
KAFKA_CLUSTER_ID=
# 클라이언트(Filebeat, Logstash)가 접속할 브로커 주소. 인증서 SAN 에도 들어감
KAFKA1_EXTERNAL_HOST=kafka1.logflow.internal
KAFKA2_EXTERNAL_HOST=kafka2.logflow.internal
KAFKA3_EXTERNAL_HOST=kafka3.logflow.internal
KAFKA_KEYSTORE_PASSWORD=
KAFKA_TRUSTSTORE_PASSWORD=
# SASL/PLAIN 계정 (admin: 브로커 간 통신·운영, filebeat: 쓰기 전용, logstash: 읽기 전용)
KAFKA_ADMIN_PASSWORD=
KAFKA_FILEBEAT_PASSWORD=
KAFKA_LOGSTASH_PASSWORD=

# ---------- Elastic Stack (deploy/prod/elk) ----------
STACK_VERSION=8.10.0
ES_CLUSTER_NAME=logflow-prod
ES_MEM_LIMIT=4g
ES_JAVA_HEAP=2g
# elastic 슈퍼유저 / kibana_system / logstash_internal(쓰기 전용) 비밀번호
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
LOGSTASH_ES_PASSWORD=
# Kibana 저장 객체 암호화 키 (32자 이상): openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=
LOGSTASH_REPLICAS=2

# ---------- 앱 서버 에이전트 (deploy/prod/agent) ----------
APP_IMAGE=registry.logflow.internal/logflow:0.0.1
# Kibana 에서 서버를 구분하는 이름 (host.name 으로 들어감)
AGENT_NAME=app-server-01
