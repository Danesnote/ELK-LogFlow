{
  "index_patterns": ["logflow-*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "logflow-policy",
      "index.refresh_interval": "5s"
    },
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 1024 }
          }
        }
      ],
      "properties": {
        "@timestamp":  { "type": "date" },
        "message":     { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
        "level":       { "type": "keyword" },
        "level_value": { "type": "integer" },
        "logger_name": { "type": "keyword" },
        "thread_name": { "type": "keyword" },
        "stack_trace": { "type": "text" },
        "traceId":     { "type": "keyword" },
        "app":         { "type": "keyword" },
        "host":        { "properties": { "name": { "type": "keyword" } } },
        "log":         { "properties": { "file": { "properties": { "path": { "type": "keyword" } } }, "offset": { "type": "long" } } }
      }
    }
  },
  "_meta": {
    "description": "LogstashEncoder JSON 필드 매핑 고정 (동적 매핑으로 타입이 흔들리지 않게)"
  }
}
